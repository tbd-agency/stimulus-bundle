{
  "name": "tbd/stimulus-bundle",
  "description": "A Symfony bundle containing a shared library of reusable stimulus controllers.",
  "type": "symfony-bundle",
  "keywords": ["symfony-ux"],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Tbd\\StimulusBundle\\": "src/"
    }
  },
  "authors": [
    {
      "name": "TBD",
      "email": "info@tbd.be"
    }
  ],
  "require": {
    "knplabs/knp-paginator-bundle": "^6.0",
    "php": ">=8.4",
    "ramsey/uuid-doctrine": "^1.5 || ^2.1",
    "symfony/config": "^7.0 || ^8.0",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "^7.0 || ^8.0",
    "symfony/options-resolver": "^7.0 || ^8.0",
    "symfony/stimulus-bundle": "^2.23 || ^3.0",
    "symfony/ux-icons": "^2.23 || ^3.0",
    "symfony/ux-twig-component": "^2.23 || ^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": false
    }
  }
}
