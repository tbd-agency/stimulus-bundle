{
  "name": "@tbd/stimulus-bundle",
  "description": "Stimulus controllers used in TBD projects",
  "license": "MIT",
  "version": "1.0.0",
  "symfony": {
    "controllers": {
      "ajax-submit": {
        "main": "src/ajax_submit_controller.js",
        "name": "ajax-submit",
        "fetch": "lazy",
        "enabled": false
      },
      "app": {
        "main": "src/app_controller.js",
        "name": "app",
        "fetch": "eager",
        "enabled": false
      },
      "chart": {
        "main": "src/chart_controller.js",
        "name": "chart",
        "fetch": "lazy",
        "enabled": false
      },
      "closeable": {
        "main": "src/closeable_controller.js",
        "name": "closeable",
        "fetch": "lazy",
        "enabled": false,
        "autoimport": {
          "@tbd/stimulus-bundle/styles/closeable.css": true
        }
      },
      "confirm": {
        "main": "src/confirm_controller.js",
        "name": "confirm",
        "fetch": "lazy",
        "enabled": false
      },
      "dashboard": {
        "main": "src/dashboard_controller.js",
        "name": "dashboard",
        "fetch": "lazy",
        "enabled": false
      },
      "dropdown": {
        "main": "src/dropdown_controller.js",
        "name": "dropdown",
        "fetch": "lazy",
        "enabled": false
      },
      "flatpickr": {
        "main": "src/flatpickr_controller.js",
        "name": "flatpickr",
        "fetch": "lazy",
        "enabled": false,
        "autoimport": {
          "@tbd/stimulus-bundle/styles/flatpickr.css": true
        }
      },
      "inline-edit": {
        "main": "src/inline_edit_controller.js",
        "name": "inline-edit",
        "fetch": "lazy",
        "enabled": false
      },
      "marker": {
        "main": "src/marker_controller.js",
        "name": "marker",
        "fetch": "lazy",
        "enabled": false
      },
      "modal": {
        "main": "src/modal_controller.js",
        "name": "modal",
        "fetch": "lazy",
        "enabled": false
      },
      "reset-search": {
        "main": "src/reset_search_controller.js",
        "name": "reset-search",
        "fetch": "lazy",
        "enabled": false
      },
      "select-items": {
        "main": "src/select_items_controller.js",
        "name": "select-items",
        "fetch": "lazy",
        "enabled": false
      },
      "sidebar": {
        "main": "src/sidebar_controller.js",
        "name": "sidebar",
        "fetch": "lazy",
        "enabled": false
      },
      "sortable": {
        "main": "src/sortable_controller.js",
        "name": "sortable",
        "fetch": "eager",
        "enabled": false
      },
      "theme": {
        "main": "src/theme_controller.js",
        "name": "theme",
        "fetch": "eager",
        "enabled": false
      },
      "tooltip": {
        "main": "src/tooltip_controller.js",
        "name": "tooltip",
        "fetch": "lazy",
        "enabled": false
      },
      "url": {
        "main": "src/url_controller.js",
        "name": "url",
        "fetch": "lazy",
        "enabled": false,
        "autoimport": {
          "@tbd/stimulus-bundle/styles/url.css": true
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.2.2",
      "@hotwired/turbo": "^7.3.0 || ^8.0.0",
      "chart.js/auto": "^3.4.1 || ^4.0.0",
      "js-cookie": "^3.0.5",
      "flowbite": "^2.0.0 || ^3.0.0 || ^4.0.0",
      "@popperjs/core": "^2.11.8",
      "flatpickr": "^4.6.13",
      "sortablejs": "^1.15.0",
      "@symfony/ux-live-component": "^2.0.0"
    }
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^7.3.0 || ^8.0.0",
    "chart.js": "^3.4.1 || ^4.0.0",
    "js-cookie": "^3.0.5",
    "flowbite": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@popperjs/core": "^2.11.8",
    "flatpickr": "^4.6.13",
    "sortablejs": "^1.15.0",
    "@symfony/ux-live-component": "^2.0.0"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^7.3.0 || ^8.0.0",
    "chart.js": "^3.4.1 || ^4.0.0",
    "js-cookie": "^3.0.5",
    "flowbite": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@popperjs/core": "^2.11.8",
    "flatpickr": "^4.6.13",
    "sortablejs": "^1.15.0",
    "@symfony/ux-live-component": "^2.0.0"
  }
}
